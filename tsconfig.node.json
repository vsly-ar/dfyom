// src/core and src/shared are checked here (no DOM lib) AND in tsconfig.web.json (no Node types):
// together that keeps them environment-neutral. See ADR 0015.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "vitest.perf.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/shared/**/*"
  ]
}
