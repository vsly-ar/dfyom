// src/core and src/shared are checked here (no Node types) AND in tsconfig.node.json (no DOM lib):
// together that keeps them environment-neutral. See ADR 0015.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src/renderer/src/**/*", "src/core/**/*", "src/shared/**/*"],
  "exclude": ["src/renderer/src/ui/tokens.test.ts"]
}
